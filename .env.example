# ===== SERVER =====
MC_HOST=
MC_PORT=
MC_USERNAME=AFK_Bot
MC_SERVER_VERSION=26.3
MC_VERSION=26.1
MC_AUTH=offline

# ===== ĐĂNG NHẬP (bạn tự register acc trước) =====
MC_PASSWORD=
MC_LOGIN_COMMAND=/login {password}
MC_LOGIN_DELAY_MS=5000
MC_LOGIN_SETTLE_MS=3000
MC_LOGIN_ON_EVERY_SPAWN=false

# ===== AFK =====
AFK_MODE=auto
AFK_ENABLED=true
AFK_MIN_INTERVAL_MS=25000
AFK_MAX_INTERVAL_MS=60000
AFK_AUTO_EAT=true
AFK_CHAT_MESSAGE=
AFK_CHAT_INTERVAL_MS=600000
MC_TICK_END=true
MC_VIEW_DISTANCE=tiny
MC_JOIN_COMMANDS=
MC_JOIN_COMMAND_DELAY_MS=2000

# ===== KỸ THUẬT =====
MC_SPAWN_TIMEOUT_MS=60000
MC_CHECK_TIMEOUT_MS=60000
RECONNECT_MIN_DELAY_MS=15000
RECONNECT_MAX_DELAY_MS=300000
RECONNECT_RESET_AFTER_MS=60000
PORT=8080
LOG_LEVEL=info
STATS_INTERVAL_MS=300000
DISCORD_WEBHOOK_URL=
NOTIFY_DOWN_AFTER_MS=300000
